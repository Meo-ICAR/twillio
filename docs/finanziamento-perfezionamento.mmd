    luogo_nascita[/"Luogo di nascita (non ricavabile dal codice fiscale):"/]
    residenza[/"Indirizzo di residenza (via, numero, CAP, città):"/]
    stato_civile["Stato civile:"]
    documento_tipo["Tipo di documento d#39;identità:"]
    documento_numero[/"Numero del documento:"/]
    documento_scadenza[/"Scadenza del documento (gg/mm/aaaa):"/]
    telefono[/"Telefono del cliente:"/]
    email[/"Email del cliente:"/]
    iban[/"IBAN per l#39;erogazione:"/]
