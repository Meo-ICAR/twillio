    codice --> conferma_pratica
    conferma_pratica -->|"No"| codice
    conferma_pratica -->|"Sì"| riepilogo_documenti
    riepilogo_documenti --> informativa
    informativa --> codice_fiscale
    codice_fiscale --> cognome
    cognome --> nome
    nome --> verifica_cf
    verifica_cf -->|"Coerenti"| luogo_nascita
    verifica_cf -->|"Non coerenti"| conferma_cf
    conferma_cf -->|"Lo reinserisco"| codice_fiscale
    conferma_cf -->|"Confermo il codice"| luogo_nascita
    luogo_nascita --> residenza
    residenza --> stato_civile
    stato_civile --> documento_tipo
    documento_tipo --> documento_numero
    documento_numero --> documento_scadenza
    documento_scadenza --> telefono
    telefono --> email
    email --> iban
    iban -->|"Altre risposte"| datore_lavoro
    iban -->|"Leasing / Finanziamento aziendale"| ragione_sociale
    datore_lavoro --> data_assunzione
    data_assunzione --> doc_identita
    ragione_sociale --> partita_iva
    partita_iva --> doc_identita
    doc_identita --> doc_cf
    doc_cf --> doc_reddito
    doc_reddito --> riepilogo_p
